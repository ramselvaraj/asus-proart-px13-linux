#!/usr/bin/python3
"""Follow Linux SW_TABLET_MODE and control the ASUS keyboard backlight."""

from __future__ import annotations

import fcntl
import glob
import os
import select
import struct
import sys
import time


EV_SW = 0x05
SW_TABLET_MODE = 0x01
EVENT = struct.Struct("@llHHI")
LED = "/sys/class/leds/asus::kbd_backlight/brightness"
SAVED_LEVEL = "/var/lib/asus-tablet-backlight/saved-level"

IOC_NRBITS = 8
IOC_TYPEBITS = 8
IOC_SIZEBITS = 14
IOC_NRSHIFT = 0
IOC_TYPESHIFT = IOC_NRSHIFT + IOC_NRBITS
IOC_SIZESHIFT = IOC_TYPESHIFT + IOC_TYPEBITS
IOC_DIRSHIFT = IOC_SIZESHIFT + IOC_SIZEBITS
IOC_READ = 2


def ioc(direction: int, kind: int, number: int, size: int) -> int:
    return (
        direction << IOC_DIRSHIFT
        | kind << IOC_TYPESHIFT
        | number << IOC_NRSHIFT
        | size << IOC_SIZESHIFT
    )


def eviocgsw(size: int) -> int:
    return ioc(IOC_READ, ord("E"), 0x1B, size)


def read_text(path: str) -> str:
    with open(path, encoding="ascii") as stream:
        return stream.read().strip()


def write_text(path: str, value: int) -> None:
    with open(path, "w", encoding="ascii") as stream:
        stream.write(f"{value}\n")


def has_tablet_switch(input_dir: str) -> bool:
    try:
        words = read_text(os.path.join(input_dir, "capabilities/sw")).split()
        capabilities = int("".join(words), 16)
        return bool(capabilities & (1 << SW_TABLET_MODE))
    except (FileNotFoundError, PermissionError, ValueError):
        return False


def find_tablet_device() -> str | None:
    for input_dir in glob.glob("/sys/class/input/input*"):
        if not has_tablet_switch(input_dir):
            continue
        events = glob.glob(os.path.join(input_dir, "event*"))
        if events:
            return os.path.join("/dev/input", os.path.basename(events[0]))
    return None


def current_tablet_state(fd: int) -> bool:
    switches = bytearray(8)
    fcntl.ioctl(fd, eviocgsw(len(switches)), switches, True)
    return bool(switches[SW_TABLET_MODE // 8] & (1 << (SW_TABLET_MODE % 8)))


def saved_level() -> int | None:
    try:
        value = int(read_text(SAVED_LEVEL))
        return value if value > 0 else None
    except (FileNotFoundError, PermissionError, ValueError):
        return None


def save_level(value: int) -> None:
    os.makedirs(os.path.dirname(SAVED_LEVEL), mode=0o755, exist_ok=True)
    write_text(SAVED_LEVEL, value)


def clear_saved_level() -> None:
    try:
        os.unlink(SAVED_LEVEL)
    except FileNotFoundError:
        pass


def reconcile(tablet_mode: bool) -> None:
    try:
        current = int(read_text(LED))
        if tablet_mode:
            if current > 0 and saved_level() is None:
                save_level(current)
                print(f"tablet mode: saved backlight level {current}", flush=True)
            if current != 0:
                write_text(LED, 0)
                print("tablet mode: keyboard backlight off", flush=True)
        else:
            restore = saved_level()
            if restore is not None:
                write_text(LED, restore)
                clear_saved_level()
                print(
                    f"laptop mode: restored backlight level {restore}",
                    flush=True,
                )
    except (FileNotFoundError, PermissionError, OSError, ValueError) as error:
        print(f"backlight unavailable: {error}", file=sys.stderr, flush=True)


def follow_device(path: str) -> None:
    with open(path, "rb", buffering=0) as device:
        tablet_mode = current_tablet_state(device.fileno())
        print(
            f"following {path}; initial mode="
            f"{'tablet' if tablet_mode else 'laptop'}",
            flush=True,
        )
        reconcile(tablet_mode)

        while True:
            readable, _, _ = select.select([device], [], [], 2.0)
            if not readable:
                reconcile(tablet_mode)
                continue

            data = os.read(device.fileno(), EVENT.size * 32)
            if not data:
                raise OSError("input device disappeared")

            for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, event_type, code, value = EVENT.unpack_from(data, offset)
                if event_type == EV_SW and code == SW_TABLET_MODE:
                    new_mode = bool(value)
                    if new_mode != tablet_mode:
                        tablet_mode = new_mode
                        print(
                            f"mode changed to "
                            f"{'tablet' if tablet_mode else 'laptop'}",
                            flush=True,
                        )
                    reconcile(tablet_mode)


def main() -> None:
    last_wait_message = 0.0
    while True:
        path = find_tablet_device()
        if path is None:
            now = time.monotonic()
            if now - last_wait_message >= 30:
                print(
                    "waiting for SW_TABLET_MODE "
                    "(reboot may be required after enabling tablet_mode_sw=2)",
                    flush=True,
                )
                last_wait_message = now
            time.sleep(2)
            continue

        try:
            follow_device(path)
        except (FileNotFoundError, PermissionError, OSError) as error:
            print(f"{path}: {error}; rescanning", file=sys.stderr, flush=True)
            time.sleep(2)


if __name__ == "__main__":
    main()
